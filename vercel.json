{
  "framework": "nextjs",
  "functions": {
    "app/api/**": {
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/cron/reminders",      "schedule": "0 * * * *"    },
    { "path": "/api/cron/payment-safety", "schedule": "*/5 * * * *"  },
    { "path": "/api/cron/payout-retry",   "schedule": "0 */4 * * *"  }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
