
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:C:/Desktop/Projects/Mbole-Pay/prisma/dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  username  String?  @unique
  password  String?  // Hashed password (optional for Google OAuth users)
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships   Membership[]
  contributions Contribution[]
  payments      Payment[]
  payouts       Payout[]
}

model Group {
  id              String   @id @default(cuid())
  name            String
  description     String?
  inviteCode      String   @unique
  contributionAmount Int    // Amount each member must contribute
  frequency       String   // "WEEKLY" | "MONTHLY" | "QUARTERLY"
  cycleType       String   // "ROTATING" | "FIXED"
  status          String   @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  creator_id      String
  memberships     Membership[]
  contributions   Contribution[]
  payments        Payment[]
  payouts         Payout[]
  disputes        Dispute[]
}

model Membership {
  id        String @id @default(cuid())
  role      String // "ADMIN" | "TREASURER" | "MEMBER"
  userId    String
  groupId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
}

model Contribution {
  id        String   @id @default(cuid())
  amount    Int
  status    String   @default("PENDING") // "PENDING" | "PAID" | "OVERDUE"
  dueDate   DateTime
  paidAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  groupId   String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payment Payment?
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  groupId         String
  group           Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  contributionId  String?  @unique
  contribution    Contribution? @relation(fields: [contributionId], references: [id], onDelete: SetNull)
  
  amount          Float
  currency        String   @default("XAF")
  status          String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  
  provider        String                        // MTN_MOMO or ORANGE_MONEY
  providerRef     String?  @unique             // Reference from payment provider
  phoneNumber     String                        // Phone number used for payment
  
  retryCount      Int      @default(0)
  lastRetry       DateTime?
  errorMessage    String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Payout {
  id              String   @id @default(cuid())
  groupId         String
  group           Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  recipientId     String
  recipient       User     @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  
  amount          Float
  currency        String   @default("XAF")
  status          String   @default("PENDING") // PENDING, SCHEDULED, PROCESSING, COMPLETED, FAILED
  
  provider        String                        // MTN_MOMO or ORANGE_MONEY
  providerRef     String?  @unique
  phoneNumber     String
  
  scheduledDate   DateTime
  processedDate   DateTime?
  
  retryCount      Int      @default(0)
  lastRetry       DateTime?
  errorMessage    String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Dispute {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("OPEN") // "OPEN" | "RESOLVED"
  groupId     String
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  votes DisputeVote[]
}

model DisputeVote {
  id        String   @id @default(cuid())
  vote      String   // "UPHOLD" | "REJECT"
  disputeId String
  createdAt DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  
  // Email notifications
  emailPaymentSuccess        Boolean  @default(true)
  emailPaymentFailed         Boolean  @default(true)
  emailPayoutScheduled       Boolean  @default(true)
  emailDisputeFiled          Boolean  @default(true)
  emailVotingReminder        Boolean  @default(true)
  emailContributionReminder  Boolean  @default(true)
  
  // SMS notifications
  smsPaymentSuccess          Boolean  @default(true)
  smsPaymentFailed           Boolean  @default(true)
  smsPayoutScheduled         Boolean  @default(true)
  smsDisputeFiled            Boolean  @default(false)
  smsVotingReminder          Boolean  @default(true)
  smsContributionReminder    Boolean  @default(true)
  
  // Quiet hours (do not notify during these times)
  notificationQuietHours     Boolean  @default(false)
  quietHoursStart            String   @default("22:00") // HH:MM format
  quietHoursEnd              String   @default("08:00")  // HH:MM format
  
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}